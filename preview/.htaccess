# Tanish Arts Preview — Apache rules
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve private folders, even if a nested .htaccess is missing.
    RewriteRule ^(storage|inc)(/|$) - [F,L,NC]

    # Pretty client links: /preview/p/<id>  ->  p.php?id=<id>
    RewriteRule ^p/([A-Za-z0-9_-]{20,64})/?$ p.php?id=$1 [L,QSA]
</IfModule>

# Hide documentation, config and dot files.
<FilesMatch "(^\.|\.(md|ini|txt|json|lock|log|ttf)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Fonts are served from this folder (no CDNs).
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
